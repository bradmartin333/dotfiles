{
  "permissions": {
    "allow": [
      "Bash(git checkout -b feature/*)",
      "Bash(git checkout -b bugfix/*)",
      "Bash(git branch feature/*)",
      "Bash(git branch bugfix/*)",
      "mcp__vikunja__projects_read",
      "mcp__vikunja__tasks_list",
      "mcp__vikunja__tasks_read",
      "mcp__vikunja__tasks_create",
      "mcp__vikunja__tasks_update",
      "mcp__vikunja__labels_list",
      "mcp__vikunja__labels_read",
      "mcp__vikunja__projects_list",
      "mcp__vikunja__task_comments_list",
      "mcp__vikunja__task_comments_read",
      "mcp__vikunja__task_comments_create",
      "mcp__vikunja__users_search",
      "mcp__vikunja__find_action"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command' | grep -q 'git worktree' && echo '{\"continue\":false,\"stopReason\":\"Git worktrees are disabled. Use git checkout -b feature/... or bugfix/... to create branches instead.\"}' || echo '{\"continue\":true}'",
            "statusMessage": "Checking for worktree usage..."
          }
        ]
      }
    ]
  },
  "enableWorkflows": true,
  "effortLevel": "high",
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "useAutoModeDuringPlan": false
}
