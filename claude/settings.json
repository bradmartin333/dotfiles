{
  "permissions": {
    "allow": [
      "Bash(git checkout -b feature/*)",
      "Bash(git checkout -b bugfix/*)",
      "Bash(git checkout -b hotfix/*)",
      "Bash(git branch feature/*)",
      "Bash(git branch bugfix/*)",
      "Bash(git branch hotfix/*)",
      "mcp__vikunja__projects_read",
      "mcp__vikunja__tasks_list",
      "mcp__vikunja__tasks_read",
      "mcp__vikunja__tasks_create",
      "mcp__vikunja__tasks_update",
      "mcp__vikunja__labels_list",
      "mcp__vikunja__labels_read",
      "mcp__vikunja__projects_list",
      "mcp__vikunja__task_comments_list",
      "mcp__vikunja__task_comments_read",
      "mcp__vikunja__task_comments_create",
      "mcp__vikunja__task_comments_update",
      "mcp__vikunja__users_search",
      "mcp__vikunja__find_action",
      "mcp__vikunja__do_action",
      "mcp__vikunja__filter_syntax"
    ],
    "ask": [
      "EnterWorktree",
      "Bash(git worktree add *)",
      "Bash(git -C * worktree add *)"
    ],
    "deny": [
      "Read(~/.git-credentials)",
      "Read(~/.claude.json)",
      "Read(**/.env*)"
    ]
  },
  "model": "opus",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "jq -e '.tool_input.isolation == \"worktree\"' >/dev/null && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"ask\",\"permissionDecisionReason\":\"Subagent wants its own git worktree\"}}' || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.dotfiles/claude/hooks/worktree-cleanup.sh\"",
            "statusMessage": "Checking for leftover worktrees..."
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "enableWorkflows": true,
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true,
  "autoMode": {
    "environment": [
      "$defaults",
      "**Source control**: any repo under github.com/bradmartin333 is mine and trusted",
      "**Trusted internal domains**: tasks.coblab.net (Vikunja), homelab (Tailscale)",
      "**Primary use**: personal software development and homelab"
    ]
  }
}
