[user]
	name = bradmartin333
	email = bradmartin333@gmail.com
[init]
	defaultBranch = main
[alias]
	cmp = "!f() { git add -A && git commit -m \"$@\" && git push; }; f"
	ac = "!git add -A && git commit -m "
	gone = !git checkout main && git pull --prune && git branch -vv | awk \"/: gone]/{print \\$1}\" | xargs -r git branch -d
[fetch]
	prune = true
[push]
	autoSetupRemote = true
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
